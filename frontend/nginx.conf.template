server {
    listen ${PORT};
    server_name _;

    # 静态文件
    root /usr/share/nginx/html;
    index index.html;

    # gzip 提速
    gzip on;
    gzip_min_length 512;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml;
    gzip_vary on;

    # SSE 流式接口：禁用缓冲、加长超时
    location /api/v1/screener/nl/stream {
        proxy_pass         ${BACKEND_PROXY_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_name    $proxy_host;

        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 1800s;
        proxy_send_timeout 1800s;
        chunked_transfer_encoding off;
    }

    # /api/* 反代到 backend service。Railway 上用 BACKEND_PROXY_URL 指向后端服务。
    location /api/ {
        proxy_pass         ${BACKEND_PROXY_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $proxy_host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_ssl_server_name on;
        proxy_ssl_name    $proxy_host;

        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # SPA fallback：所有非文件路径回到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源长缓存
    location ~* \.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }
}
