# 应用配置
APP_NAME=QwenStockScreener
DEBUG=True
API_PREFIX=/api/v1

# 数据库（默认 SQLite，可改 MySQL：mysql+pymysql://user:pass@localhost:3306/dbname）
DATABASE_URL=sqlite:///./stock.db

# Redis（可选，未设置则不启用缓存）
REDIS_URL=redis://localhost:6379/0

# baostock 分钟 K 拉取：首次超时后短路一段时间，避免反复阻塞页面
BAOSTOCK_INTRADAY_TIMEOUT=6
BAOSTOCK_INTRADAY_BREAKER_SECONDS=300

# JWT
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 大模型后端 =====
# openai (默认) 或 dashscope
AI_BACKEND=openai

# OpenAI 兼容（支持 OpenCode Go / OpenAI / 自建网关）
OPENAI_API_KEY=your-openai-compatible-key
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
OPENAI_MODEL=qwen3.6-plus
OPENAI_REASONING=high
# OpenCode Go 当前走 Chat Completions 兼容接口；不支持 Responses API 时保持 false
OPENAI_RESPONSES_ENABLED=false
# Agent 模型调用超时：慢时安全停止，不本地兜底筛选
AGENT_PLAN_TIMEOUT_SECONDS=10
AGENT_REACT_STEP_TIMEOUT_SECONDS=18

# 阿里云百炼（备用，AI_BACKEND=dashscope 时启用）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
