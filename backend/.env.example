# 应用配置
APP_NAME=QwenStockScreener
DEBUG=True
API_PREFIX=/api/v1

# 数据库（默认 SQLite，可改 MySQL：mysql+pymysql://user:pass@localhost:3306/dbname）
DATABASE_URL=sqlite:///./stock.db

# Redis（可选，未设置则不启用缓存）
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 大模型后端 =====
# 使用阿里云千问：AI_BACKEND=dashscope + 填 DASHSCOPE_API_KEY（推荐）
# 使用 OpenAI 兼容网关：AI_BACKEND=openai + OPENAI_API_KEY
AI_BACKEND=dashscope

# OpenAI 兼容（支持中转 / 自建网关）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING=high

# 阿里云百炼（千问官方 API，详情页评分 / 问千问 / 对话筛选）
DASHSCOPE_API_KEY=sk-your-key-here
QWEN_MODEL=qwen-max

# 个股千问评分缓存秒数（默认 7 天，同一基本面快照不重复扣费）
QWEN_SCORE_CACHE_TTL=604800

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
