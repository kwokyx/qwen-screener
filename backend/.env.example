# 应用配置
APP_NAME=QwenStockScreener
DEBUG=True
API_PREFIX=/api/v1

# 数据库（默认 SQLite，可改 MySQL：mysql+pymysql://user:pass@localhost:3306/dbname）
DATABASE_URL=sqlite:///./stock.db

# Redis（可选，未设置则不启用缓存）
REDIS_URL=redis://localhost:6379/0

# baostock 分钟 K 拉取：首次超时后短路一段时间，避免反复阻塞页面
BAOSTOCK_INTRADAY_TIMEOUT=6
BAOSTOCK_INTRADAY_BREAKER_SECONDS=300

# JWT
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 大模型后端 =====
# openai (默认) 或 dashscope
AI_BACKEND=openai

# OpenAI 兼容（支持中转 / 自建网关）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api2.up.railway.app
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REASONING=high

# 阿里云百炼（备用，AI_BACKEND=dashscope 时启用）
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-plus

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
